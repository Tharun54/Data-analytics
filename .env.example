# Copy to .env and fill in. Never commit .env.
CSE_SECRET_KEY=change-me-to-a-long-random-string
CSE_DATABASE_URL=sqlite:///./cseplus.db
# Leave empty to run the offline demo engine (no AI calls, synthetic data).
ANTHROPIC_API_KEY=
CSE_MODEL=claude-opus-5-5
# low | medium | high  — higher = deeper research, more cost/latency
CSE_EFFORT=medium
CSE_WEB_SEARCH=true
